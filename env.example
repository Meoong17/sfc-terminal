# SFC Terminal Pro — Environment Variables
# Copy this file to .env and fill in your API keys
# (GitHub Actions secrets: Settings → Secrets and variables → Actions)

# CoinMarketCap API Key (primary data source — recommended)
# Used for: BTC price, 24h change, market cap, dominance
# Get one free at: https://pro.coinmarketcap.com/
CMC_API_KEY=

# FRED API Key (Federal Reserve Economic Data)
# Used for: M2 Money Supply (Lt factor) and DXY (Sc factor)
# Get one free at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# CryptoPanic API Key (optional — public endpoint works but may be rate-limited)
# Used for: news sentiment aggregation
# Get one at: https://cryptopanic.com/developers/api/
CRYPTOPANIC_KEY=

# CoinGlass API Key (optional — used for liquidation heatmap / futures data)
# Without this, liquidation_client.py falls back to unauthenticated requests,
# which may be rate-limited or return partial data.
# Get one at: https://coinglass.com/pricing
COINGLASS_API_KEY=

# ── Cloudflare Worker secrets (NOT set in this file) ──
# The worker (worker/index.js) reads these from Cloudflare's encrypted
# secret store, never from a committed file. Set them once with:
#
#   wrangler secret put BACKUP_URL       # your VPS direct URL, e.g. http://YOUR_VPS_IP:8765
#   wrangler secret put SESSION_SECRET   # any long random string, used to sign session cookies
#
# If SESSION_SECRET is left unset, the worker issues unsigned session
# cookies (the old behavior) and logs a warning — set it before deploying
# this repo publicly, since session forgery is otherwise trivial.
