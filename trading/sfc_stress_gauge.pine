//@version=5
// ============================================================================
//  SFC STRESS GAUGE — "SFC-lite" (price-based port of the SFC stress concept)
//  with LIVE SFC AUTO-FETCH + manual override fallback
//  ----------------------------------------------------------------------------
//  Faithful-ish port of the PORTABLE core of the SFC (Super Fidelity Composite)
//  stress index into TradingView Pine Script v5.
//
//  IMPORTANT — HONEST SCOPE (read before trusting):
//  The full SFC model is a 31+ method ensemble pulling external APIs (FRED,
//  CoinGecko, stablecoin/global liquidity, on-chain MVRV, Binance funding &
//  order-flow) plus ML (XGBoost/HMM/Mamba). Pine cannot run that ensemble, so
//  this script does the next-best thing: it FETCHES the live composite score
//  (sfc_effective) computed by the real SFC model from the public endpoint
//  https://sfcterminal.xyz/live.json (served by the Cloudflare Worker proxy,
//  CORS-enabled for TradingView request.http).
//
//  THREE signal sources (priority order):
//    * LIVE  (auto, default) — request.http() pulls sfc_effective from the
//              live SFC Terminal endpoint. This is the REAL model number.
//    * MANUAL — type the current sfc_effective / sfc_base / news_stress by
//              hand if you prefer point-in-time entry without network.
//    * AUTO  — fallback price-based stress proxy (0-100) from price only
//              (realized-vol + drawdown + downside-tail). Used when live
//              fetch fails AND manual is off.
//
//  Cadence note: request.http() in Pine refreshes on bar close / at TradingView's
//  own cadence — it is NOT per-second. The SFC model itself updates every ~5 min.
//  On a daily chart this is more than enough; just don't expect the value to move
//  within the same open bar.
//
//  Empirical discipline (SFC 2026-08): the ONLY walk-forward era-stable edge is
//  the STRESS -> forward-return gap. Macro (VIX/M2/DXY) showed NO out-of-sample
//  edge -> shown as CONTEXT ONLY in the table, not drivers.
//  "risk-on/off" is a heuristic on the stress zone, NOT the full validated SFC
//  signal. This is an independent re-implementation for charting and does NOT
//  change SFC scoring anywhere.
//
//  USE: paste into Pine Editor, add to a BTCUSDT daily chart. If a macro symbol
//  returns "n/a" your plan lacks that feed (harmless).
// ============================================================================

indicator("SFC Stress Gauge (lite)", shorttitle="SFC Stress", overlay=false,
         max_bars_back=5000)

// ---------------------------------------------------------------------------
// Inputs — stress components (used by the AUTO price proxy only)
// ---------------------------------------------------------------------------
rvol_len   = input.int(30,     "Realized-vol window (days)",    group="Stress components")
vol_floor  = input.float(0.20, "Vol floor (annualized)",        minval=0.0, group="Stress components")
vol_ceil   = input.float(1.40, "Vol ceiling (annualized)",      minval=0.0, group="Stress components")
dd_len     = input.int(120,    "Drawdown lookback (days)",      group="Stress components")
dd_map     = input.float(0.40, "Drawdown mapped to 100 (0.40 = -40%)", minval=0.01, group="Stress components")
tail_len   = input.int(30,     "Downside-tail window (days)",   group="Stress components")
tail_thr   = input.float(-0.05,"Tail threshold (daily ret, -0.05)", group="Stress components")
tail_map   = input.float(0.30, "Tail freq mapped to 100 (0.30 = 30% days)", minval=0.01, group="Stress components")

// Weights (sum ~1)
w_rvol = input.float(0.35, "Weight realized-vol",  minval=0.0, maxval=1.0, step=0.05, group="Weights")
w_dd   = input.float(0.40, "Weight drawdown",      minval=0.0, maxval=1.0, step=0.05, group="Weights")
w_down = input.float(0.25, "Weight downside-tail", minval=0.0, maxval=1.0, step=0.05, group="Weights")

// ---------------------------------------------------------------------------
// Source selection — LIVE auto-fetch (default) | MANUAL | AUTO price proxy
// ---------------------------------------------------------------------------
use_auto   = input.bool(true,  "Use LIVE SFC score (auto-fetch)", group="Source")
use_manual = input.bool(false, "Use MANUAL SFC score (instead of auto)", group="Source")
man_sfc    = input.float(20.5, "sfc_effective (manual, 0-100)", minval=0, maxval=100, group="Source")
man_base   = input.float(20.5, "sfc_base (manual, 0-100)",      minval=0, maxval=100, group="Source")
man_news   = input.float(5.0,  "news_stress (manual, 0-100)",   minval=0, maxval=100, group="Source")

// Live endpoint (public SFC proxy, CORS-enabled). Keep it a const string —
// request.http() requires a compile-time URL.
const string LIVE_URL = "https://sfcterminal.xyz/live.json"
[string http_status, string http_body] = request.http(LIVE_URL)

// Parse the JSON once per re-evaluation. json.get() returns na when a field is
// missing or the body is invalid/unreachable, which drives the fallback chain.
live_obj   = json.parse(http_body)
live_sfc   = float(json.get(live_obj, "sfc_effective"))
live_base  = float(json.get(live_obj, "sfc_base"))
live_news  = float(json.get(live_obj, "news_stress"))
live_fetch = http_status == 200 and not na(live_sfc)

// Macro context (CONTEXT ONLY — not drivers)
show_macro = input.bool(true, "Show macro context in table (VIX/DXY/M2)", group="Macro context")
vix_sym    = input.symbol("TVC:VIX",   "VIX symbol", group="Macro context")
dxy_sym    = input.symbol("TVC:DXY",   "DXY symbol", group="Macro context")
m2_sym     = input.symbol("FRED:M2SL", "M2 symbol",  group="Macro context")

// Signal / zones
risk_off_thr = input.float(50.0, "Risk-OFF when stress >= (0-100)", minval=0, maxval=100, group="Signal / zones")
elevated_thr = input.float(25.0, "Elevated zone starts at",         minval=0, maxval=100, group="Signal / zones")

// ---------------------------------------------------------------------------
// 1) AUTO price-based stress proxy (only used when LIVE & MANUAL are off)
// ---------------------------------------------------------------------------
logret = math.log(close / close[1])
rvol   = ta.stdev(logret, rvol_len) * math.sqrt(365)
rvol_s = math.max(0.0, math.min(100.0, (rvol - vol_floor) / (vol_ceil - vol_floor) * 100.0))
hh     = ta.highest(close, dd_len)
dd     = (close - hh) / hh
dd_s   = math.max(0.0, math.min(100.0, (-dd) / dd_map * 100.0))
down   = ta.summation(logret < tail_thr ? 1.0 : 0.0, tail_len) / tail_len
down_s = math.max(0.0, math.min(100.0, down / tail_map * 100.0))
wsum   = w_rvol + w_dd + w_down
stress = wsum > 0 ? (w_rvol * rvol_s + w_dd * dd_s + w_down * down_s) / wsum : na

// ---------------------------------------------------------------------------
// 2) Macro context series (CONTEXT ONLY)
// ---------------------------------------------------------------------------
vix = request.security(vix_sym, timeframe.period, close)
dxy = request.security(dxy_sym, timeframe.period, close)
m2  = request.security(m2_sym,  timeframe.period, close)

// ---------------------------------------------------------------------------
// 3) Effective stress — LIVE > MANUAL > AUTO. Zone/risk follow it.
// ---------------------------------------------------------------------------
src_live   = use_auto and live_fetch
src_manual = use_manual
disp_stress = src_live   ? live_sfc
            : src_manual ? man_sfc
            :              stress
zone_label  = disp_stress >= risk_off_thr ? "Critical" : disp_stress >= elevated_thr ? "Elevated" : "Normal"
risk_off    = disp_stress >= risk_off_thr
risk_on     = disp_stress <  elevated_thr
src_label   = src_live   ? "LIVE" : src_manual ? "MANUAL" : "AUTO"

// ---------------------------------------------------------------------------
// 4) Plots
// ---------------------------------------------------------------------------
bgcolor(risk_off ? color.new(color.red, 85) :
        disp_stress >= elevated_thr ? color.new(color.orange, 88) : color.new(color.green, 92),
        title="Zone background")

plot(stress, "SFC Stress (AUTO proxy)",
     color = stress >= risk_off_thr ? color.red :
             stress >= elevated_thr ? color.orange : color.lime,
     linewidth=2)
hline(elevated_thr, "Elevated", color=color.new(color.orange, 60), linestyle=hline.style_dashed)
hline(risk_off_thr, "Critical", color=color.new(color.red, 60),    linestyle=hline.style_dashed)
plot(risk_off ? disp_stress : na, "Risk-OFF", color=color.new(color.red, 55), style=plot.style_columns)

// Effective (LIVE/MANUAL) value: marker on the last bar only (honest, point-in-time)
if barstate.islast and (src_live or src_manual)
    label.new(bar_index, disp_stress, "SFC live: " + str.tostring(disp_stress, "#.1") + " [" + src_label + "]",
              style=label.style_label_left, color=color.new(color.purple, 20),
              textcolor=color.white, size=size.small)
    line.new(bar_index - 10, disp_stress, bar_index, disp_stress,
             color=color.new(color.purple, 0), style=line.style_dotted, width=1)

// ---------------------------------------------------------------------------
// 5) Status table
// ---------------------------------------------------------------------------
var table t = table.new(position.bottom_right, 2, 7,
                        bgcolor=color.new(color.black, 0), frame_color=color.new(color.gray, 40))
if barstate.islast
    table.cell(t, 0, 0, "SFC Stress", text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(t, 1, 0, str.tostring(disp_stress, "#.0") + " [" + src_label + "]",
               text_color=color.white,
               bgcolor = risk_off ? color.red : disp_stress >= elevated_thr ? color.orange : color.green)
    table.cell(t, 0, 1, "Zone", text_color=color.white)
    table.cell(t, 1, 1, zone_label, text_color=color.white,
               bgcolor = risk_off ? color.red : disp_stress >= elevated_thr ? color.orange : color.green)
    table.cell(t, 0, 2, "Risk", text_color=color.white)
    table.cell(t, 1, 2, risk_off ? "OFF" : risk_on ? "ON" : "NEUTRAL", text_color=color.white,
               bgcolor = risk_off ? color.red : risk_on ? color.green : color.gray)
    if src_live
        table.cell(t, 0, 3, "sfc_base", text_color=color.white)
        table.cell(t, 1, 3, str.tostring(live_base, "#.1") +
                   " | news " + str.tostring(live_news, "#.1"), text_color=color.new(color.gray, 30))
    else if src_manual
        table.cell(t, 0, 3, "sfc_base", text_color=color.white)
        table.cell(t, 1, 3, str.tostring(man_base, "#.1") +
                   " | news " + str.tostring(man_news, "#.1"), text_color=color.new(color.gray, 30))
    else
        table.cell(t, 0, 3, "Source", text_color=color.white)
        table.cell(t, 1, 3, "AUTO price proxy (no live)", text_color=color.new(color.gray, 30))
    if show_macro
        v = na(vix) ? "n/a" : str.tostring(vix, "#.1")
        d = na(dxy) ? "n/a" : str.tostring(dxy, "#.1")
        m = na(m2)  ? "n/a" : str.tostring(m2, "#,0")
        row = 4
        table.cell(t, 0, row,   "Macro (ctx)", text_color=color.new(color.gray, 30))
        table.cell(t, 1, row,   "VIX " + v + " | DXY " + d, text_color=color.new(color.gray, 30))
        table.cell(t, 0, row+1, "", text_color=color.white)
        table.cell(t, 1, row+1, "M2 " + m, text_color=color.new(color.gray, 30))

// ---------------------------------------------------------------------------
// 6) Alerts (fire on the effective stress)
// ---------------------------------------------------------------------------
alertcondition(risk_off, "SFC Risk-OFF", "SFC stress entered Critical (>= " + str.tostring(risk_off_thr) + ")")
alertcondition(risk_on,  "SFC Risk-ON",  "SFC stress back to Normal (< " + str.tostring(elevated_thr) + ")")
