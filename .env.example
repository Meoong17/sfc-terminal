# SFC Terminal Pro — Environment Variables
# Copy this file to .env and fill in your API keys
# (GitHub Actions secrets: Settings → Secrets and variables → Actions)

# CoinMarketCap API Key (primary data source — recommended)
# Used for: BTC price, 24h change, market cap, dominance
# Get one free at: https://pro.coinmarketcap.com/
CMC_API_KEY=

# FRED API Key (Federal Reserve Economic Data)
# Used for: M2 Money Supply (Lt factor) and DXY (Sc factor)
# Get one free at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# CryptoPanic API Key (optional — public endpoint works but may be rate-limited)
# Used for: news sentiment aggregation
# Get one at: https://cryptopanic.com/developers/api/
CRYPTOPANIC_KEY=

# BGeometrics API Key (for true on-chain metrics)
# Used for: true SOPR (Spent Output Profit Ratio)
# Get one at: https://bgeometrics.com/api/
SOPR_API_KEY=

# CoinGecko API Key (for stablecoin liquidity metrics)
# Used for: stablecoin market-cap history (SLI / St factor inputs)
# Get one free at: https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=
